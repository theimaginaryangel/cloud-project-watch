    "@aws-sdk/client-secrets-manager": "^3.758.0",
    "@aws-sdk/client-sts": "^3.758.0",
    "@electric-sql/pglite": "^0.6.0",
    "@google/genai": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "groq-sdk": "^0.18.0",
    "lucide-react": "^0.511.0",
    "motion": "^12.12.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",

# PostgreSQL connection string:
# - Instant zero-Docker local Postgres (embedded PGlite): pglite://.tagwatch-data
# - Docker Compose local Postgres: postgresql://tagwatch:tagwatch@localhost:5432/tagwatch
# - Cloud Postgres (Neon / Supabase): postgresql://user:pass@host/db?sslmode=require
DATABASE_URL="pglite://.tagwatch-data"

# 32-byte hex key used to AES-256-GCM encrypt BYOK AWS/AI keys stored in Postgres.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Start in zero-config Demo Mode so anyone (or recruiters) can explore immediately.
# Set to "false" once you connect a live read-only AWS account in Settings or via env vars.
DEMO_MODE="true"

# Optional: Live Read-Only AWS Credentials (or configure encrypted keys in Settings UI)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_DEFAULT_REGION="us-east-1"

# Optional: BYOK AI Providers — configure one or BOTH (or enter them in Settings UI)
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"
# GROQ_API_KEY=""
# GROQ_MODEL="llama-3.3-70b-versatile"
# DEFAULT_AI_PROVIDER="auto" # "gemini" | "groq" | "auto"

# PostgreSQL connection string:
# - Instant zero-Docker local Postgres (embedded PGlite): pglite://.cpw-data
# - Docker Compose local Postgres: postgresql://cpw:cpw@127.0.0.1:5432/cloudprojectwatch
# - Cloud Postgres (Neon / Supabase): postgresql://user:pass@host/db?sslmode=require
DATABASE_URL="pglite://.cpw-data"

# REQUIRED for saving encrypted AWS/AI keys: 32-byte random hex key (64 hex chars).
# Generate a fresh key before running:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=""

# Start with demo data so anyone can preview the app without AWS keys.
# Set to "false" once you connect a read-only AWS account in Settings or via env vars.
DEMO_MODE="true"

# Set to "true" on a public portfolio demo so visitors cannot save keys or mutate rules.
PUBLIC_DEMO_LOCK="false"

# REQUIRED in production when PUBLIC_DEMO_LOCK="false": protects your deployment with HTTP Basic Auth.
OWNER_PASSWORD=""

# Explicit opt-in required to allow `env_default` mode (~/.aws/credentials or host IAM role / IMDS).
# Keep "false" on shared servers or cloud hosts so host roles cannot be enumerated.
ALLOW_AMBIENT_AWS_CREDENTIALS="false"

# Optional: Read-only AWS credentials (when ALLOW_AMBIENT_AWS_CREDENTIALS="true", or save IAM keys in Settings)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_DEFAULT_REGION="us-east-1"

# Optional: BYOK AI providers (configure Gemini, Groq, or both)
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"
# GROQ_API_KEY=""
# GROQ_MODEL="llama-3.3-70b-versatile"
# DEFAULT_AI_PROVIDER="auto" # "gemini" | "groq" | "auto"

# PostgreSQL connection string:
# - Instant zero-Docker local Postgres (embedded PGlite): pglite://.cpw-data
# - Docker Compose local Postgres: postgresql://cpw:cpw@localhost:5432/cloudprojectwatch
# - Cloud Postgres (Neon / Supabase): postgresql://user:pass@host/db?sslmode=require
DATABASE_URL="pglite://.cpw-data"

# 32-byte hex key used to AES-256-GCM encrypt saved AWS and AI keys in Postgres.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Start with demo data so anyone can preview the app without AWS keys.
# Set to "false" once you connect a read-only AWS account in Settings or via env vars.
DEMO_MODE="true"

# Set to "true" on a public portfolio demo so visitors cannot save keys into a shared DB.
PUBLIC_DEMO_LOCK="false"

# Optional: Set a password on your private self-hosted deployment (HTTP Basic Auth).
# Leave empty for local development or public demo deployments.
# OWNER_PASSWORD=""

# Optional: Read-only AWS credentials (or enter encrypted keys in Settings)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_DEFAULT_REGION="us-east-1"

# Optional: BYOK AI providers (configure Gemini, Groq, or both)
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"
# GROQ_API_KEY=""
# GROQ_MODEL="llama-3.3-70b-versatile"
# DEFAULT_AI_PROVIDER="auto" # "gemini" | "groq" | "auto"
